#!/usr/bin/env bash

set -euo pipefail

usage() {
	local fd="${1:-2}"
	cat <<EOF >&"$fd"
Usage: gh-readonly <command> [subcommand] [flags]

Runs gh only for read-only commands and rejects everything else.

Allowed commands:
  pr view|list|diff|checks|status
  issue view|list|status
  run view|list|watch
  workflow view|list
  release view|list
  repo view|list
  label list
  search repos|issues|prs|commits|code
  auth status (without --show-token)
  api <endpoint> (GET only)
    flags: --paginate, --slurp, -i/--include, --silent, --verbose,
           -q/--jq, -t/--template, --cache, --hostname, -H/--header,
           -X/--method GET
  status, help, version, --version

Requires: gh

Examples:
  gh-readonly pr view 123
  gh-readonly api repos/cli/cli/pulls --paginate --jq '.[].title'
EOF
}

is_allowed_api_flag_value() {
	local flag="$1" value="$2"
	case "${flag}" in
	-X | --method) [[ "${value}" == [Gg][Ee][Tt] ]] ;;
	-H | --header) [[ "${value}" != *[Mm][Ee][Tt][Hh][Oo][Dd]* ]] ;;
	*) return 0 ;;
	esac
}

is_allowed_api_args() {
	local endpoint="" arg
	while [[ $# -gt 0 ]]; do
		arg="$1"
		case "${arg}" in
		--paginate | --slurp | -i | --include | --silent | --verbose) ;;
		-q | --jq | -t | --template | --cache | --hostname | -H | --header | -X | --method)
			[[ $# -ge 2 ]] || return 1
			is_allowed_api_flag_value "${arg}" "$2" || return 1
			shift
			;;
		--jq=* | --template=* | --cache=* | --hostname=* | --header=* | --method=*)
			is_allowed_api_flag_value "${arg%%=*}" "${arg#*=}" || return 1
			;;
		-*) return 1 ;;
		*)
			[[ -z "${endpoint}" && "${arg}" != "graphql" ]] || return 1
			endpoint="${arg}"
			;;
		esac
		shift
	done
	[[ -n "${endpoint}" ]]
}

is_allowed_auth_status_args() {
	local arg
	for arg in "$@"; do
		[[ "${arg}" == "--show-token" || "${arg}" =~ ^-[^-]*t ]] && return 1
	done
	return 0
}

is_allowed() {
	local command="$1" subcommand="${2:-}"
	case "${command}" in
	status | help | version | --version) return 0 ;;
	api)
		shift
		is_allowed_api_args "$@"
		return
		;;
	auth)
		[[ "${subcommand}" == "status" ]] || return 1
		shift 2
		is_allowed_auth_status_args "$@"
		return
		;;
	esac
	case "${command} ${subcommand}" in
	"pr view" | "pr list" | "pr diff" | "pr checks" | "pr status") return 0 ;;
	"issue view" | "issue list" | "issue status") return 0 ;;
	"run view" | "run list" | "run watch") return 0 ;;
	"workflow view" | "workflow list") return 0 ;;
	"release view" | "release list") return 0 ;;
	"repo view" | "repo list") return 0 ;;
	"label list") return 0 ;;
	"search repos" | "search issues" | "search prs") return 0 ;;
	"search commits" | "search code") return 0 ;;
	esac
	return 1
}

main() {
	if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
		usage 1
		return 0
	fi

	if ! command -v gh >/dev/null 2>&1; then
		echo "Error: gh command not found" >&2
		return 1
	fi

	if [[ $# -gt 0 ]] && ! is_allowed "$@"; then
		echo "Error: 'gh $*' is not allowed; only read-only commands are permitted (see gh-readonly --help)" >&2
		return 1
	fi

	exec gh "$@"
}

main "$@"
