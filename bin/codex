#!/usr/bin/env bash

set -euo pipefail

usage() {
	local fd="${1:-2}"
	cat <<EOF >&"$fd"
Usage: codex [args...]

Wrapper for codex that merges config.base.toml (shared settings)
with environment-specific [projects.*] sections.
Embeds ~/.config/claude/output-styles/<output_style>.md as developer instructions.

Examples:
  codex
  codex --help
EOF
}

merge_config() {
	local base_config="${HOME}/.codex/config.base.toml"
	local config="${HOME}/.codex/config.toml"

	if [ ! -f "${base_config}" ]; then
		return 0
	fi

	local base_json
	base_json="$(taplo get -f "${base_config}" -o json | jq -S '.')"
	local output_style
	output_style="$(printf '%s' "${base_json}" | jq -r '.output_style // empty')"
	local instructions_toml=""
	if [ -n "${output_style}" ]; then
		instructions_toml="$(
			jq -n --rawfile instructions \
				"${HOME}/.config/claude/output-styles/${output_style}.md" \
				'{developer_instructions: ($instructions | sub(
					"\\A---\\r?\\n.*?\\r?\\n---(?:\\r?\\n|\\z)(?:\\r?\\n)*";
					""; "s"
				))}' | dasel -i json -o toml
		)"
	fi

	local projects_toml=""

	if [ -f "${config}" ]; then
		local config_json
		config_json="$(taplo get -f "${config}" -o json)"

		# Extract projects section as TOML
		local projects_json
		projects_json="$(printf '%s' "${config_json}" | jq '{projects}')"
		if [ "$(printf '%s' "${projects_json}" | jq '.projects')" != "null" ]; then
			projects_toml="$(printf '%s' "${projects_json}" | dasel -i json -o toml)"
		fi

		# Compare non-projects sections via JSON
		local non_projects_json
		non_projects_json="$(printf '%s' "${config_json}" |
			jq -S 'del(.projects, .developer_instructions)')"
		local shared_json
		shared_json="$(printf '%s' "${base_json}" | jq -S 'del(.output_style)')"

		# Write back to base config if shared settings were changed
		if [ "${non_projects_json}" != "{}" ] && [ "${non_projects_json}" != "${shared_json}" ]; then
			base_json="$(printf '%s' "${non_projects_json}" | jq -S '. * $base' --argjson base "${base_json}")"
			printf '%s' "${base_json}" | dasel -i json -o toml >"${base_config}"
		fi
	fi

	local base_toml
	base_toml="$(printf '%s' "${base_json}" |
		jq 'del(.output_style)' | dasel -i json -o toml)"

	# Regenerate config.toml from base + projects
	rm -f "${config}"
	printf '%s\n\n%s\n' "${instructions_toml}" "${base_toml}" >"${config}"
	if [ -n "${projects_toml}" ]; then
		printf '\n%s\n' "${projects_toml}" >>"${config}"
	fi

	return 0
}

main() {
	if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
		usage 1
		return 0
	fi

	merge_config

	local args=(
		--allow-write "$HOME/.codex"
		--allow-write "$HOME/dotfiles/dot.codex"
	)
	exec util-agent-sandbox-exec "${args[@]}" -- "$(mise which codex)" "$@"
}

main "$@"
