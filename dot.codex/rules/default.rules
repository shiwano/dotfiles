prefix_rule(pattern=["cd"], decision="allow")
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["tree"], decision="allow")
prefix_rule(pattern=["basename"], decision="allow")
prefix_rule(pattern=["readlink"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["uniq"], decision="allow")
prefix_rule(pattern=["cut"], decision="allow")
prefix_rule(pattern=["diff"], decision="allow")
prefix_rule(pattern=["mkdir"], decision="allow")
prefix_rule(pattern=["mv"], decision="allow")
prefix_rule(pattern=["test"], decision="allow")
prefix_rule(pattern=["sed", "-n"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["make", "test"], decision="allow")
prefix_rule(pattern=["go", ["get", "build", "test", "list", "vet", "doc"]], decision="allow")
prefix_rule(pattern=["go", "mod", ["graph", "why"]], decision="allow")
prefix_rule(pattern=["goimports"], decision="allow")
prefix_rule(pattern=["golangci-lint"], decision="allow")
prefix_rule(pattern=["npm", "run"], decision="allow")
prefix_rule(pattern=["bun", ["--version", "add", "run", "test"]], decision="allow")
prefix_rule(pattern=["bunx", "tsc"], decision="allow")
prefix_rule(pattern=["flutter", ["analyze", "test"]], decision="allow")
prefix_rule(pattern=["flutter", "pub", "deps"], decision="allow")
prefix_rule(pattern=["cargo", ["test", "build", "check"]], decision="allow")
prefix_rule(pattern=["uv"], decision="allow")
prefix_rule(pattern=["pytest"], decision="allow")
prefix_rule(pattern=["git", ["rm", "mv", "log", "show", "diff", "grep", "ls-files", "status"]], decision="allow")
prefix_rule(pattern=["gh-pr-comments"], decision="allow")
prefix_rule(pattern=["gh-pr-ci-failures"], decision="allow")
prefix_rule(pattern=["gh-dependabot-alerts"], decision="allow")
prefix_rule(pattern=["gh-readonly"], decision="allow")
prefix_rule(pattern=["shfmt", "-d"], decision="allow")
prefix_rule(pattern=["nvidia-smi"], decision="allow")
prefix_rule(pattern=["nvim-lint"], decision="allow")
prefix_rule(pattern=["nvim-format"], decision="allow")
prefix_rule(pattern=["codex", "review"], decision="allow")

prefix_rule(pattern=["env"], decision="forbidden")
prefix_rule(pattern=["sudo"], decision="forbidden")
prefix_rule(pattern=["wget"], decision="forbidden")
prefix_rule(pattern=["nc"], decision="forbidden")
prefix_rule(pattern=["dd"], decision="forbidden")
prefix_rule(pattern=["mkfs"], decision="forbidden")
prefix_rule(pattern=["chown", "-R"], decision="forbidden")
prefix_rule(pattern=["source"], decision="forbidden")
prefix_rule(pattern=["git", "branch", ["-D", "-d"]], decision="forbidden")
prefix_rule(pattern=["git", "push"], decision="forbidden")
prefix_rule(pattern=["tmux"], decision="forbidden")
prefix_rule(pattern=["gh"], decision="forbidden", justification="Use gh-readonly")
prefix_rule(pattern=["docker", "push"], decision="forbidden")
prefix_rule(pattern=["uv", "auth"], decision="forbidden")
prefix_rule(pattern=["npm", "publish"], decision="forbidden")
prefix_rule(pattern=["brew"], decision="forbidden")
prefix_rule(pattern=["gcloud"], decision="forbidden")
prefix_rule(pattern=["aws"], decision="forbidden")
prefix_rule(pattern=["terraform"], decision="forbidden")
prefix_rule(pattern=["kubectl"], decision="forbidden")
prefix_rule(pattern=["helm"], decision="forbidden")
