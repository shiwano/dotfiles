#!/usr/bin/env bash

set -euo pipefail

usage() {
	local fd="${1:-2}"
	cat <<EOF >&"$fd"
Usage: codex [args...]

Wrapper for codex that merges config.base.toml (shared settings)
with environment-specific [projects.*] sections.
Embeds ~/.config/claude/output-styles/custom.md as developer instructions.

Examples:
  codex
  codex --help
EOF
}

merge_config() {
	local base_config="${HOME}/.codex/config.base.toml"
	local config="${HOME}/.codex/config.toml"

	if [ ! -f "${base_config}" ]; then
		return 0
	fi

	local instructions_toml
	instructions_toml="$(
		jq -n --rawfile instructions \
			"${HOME}/.config/claude/output-styles/custom.md" \
			'{developer_instructions: $instructions}' | dasel -i json -o toml
	)"

	local projects_toml=""

	if [ -f "${config}" ]; then
		local config_json
		config_json="$(taplo get -f "${config}" -o json)"

		# Extract projects section as TOML
		local projects_json
		projects_json="$(printf '%s' "${config_json}" | jq '{projects}')"
		if [ "$(printf '%s' "${projects_json}" | jq '.projects')" != "null" ]; then
			projects_toml="$(printf '%s' "${projects_json}" | dasel -i json -o toml)"
		fi

		# Compare non-projects sections via JSON
		local non_projects_json
		non_projects_json="$(printf '%s' "${config_json}" |
			jq -S 'del(.projects, .developer_instructions)')"
		local base_json
		base_json="$(taplo get -f "${base_config}" -o json | jq -S '.')"

		# Write back to base config if shared settings were changed
		if [ "${non_projects_json}" != "{}" ] && [ "${non_projects_json}" != "${base_json}" ]; then
			local merged_json
			merged_json="$(printf '%s' "${non_projects_json}" | jq -S '. * $base' --argjson base "${base_json}")"
			printf '%s' "${merged_json}" | dasel -i json -o toml >"${base_config}"
		fi
	fi

	# Regenerate config.toml from base + projects
	rm -f "${config}"
	printf '%s\n\n%s\n' "${instructions_toml}" "$(cat "${base_config}")" >"${config}"
	if [ -n "${projects_toml}" ]; then
		printf '\n%s\n' "${projects_toml}" >>"${config}"
	fi

	return 0
}

main() {
	if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
		usage 1
		return 0
	fi

	merge_config

	local args=(
		--allow-write "$HOME/.codex"
		--allow-write "$HOME/dotfiles/dot.codex"
	)
	exec util-agent-sandbox-exec "${args[@]}" -- "$(mise which codex)" "$@"
}

main "$@"
