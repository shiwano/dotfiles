#!/usr/bin/env bash

set -euo pipefail

main() {
	local args=(
		--allow-write "$HOME/dotfiles/dot.config/claude"
		--allow-write "$HOME/.config/claude"
		--allow-write "$HOME/.codex"
		--allow-write "$HOME/dotfiles/dot.codex"
	)
	exec util-agent-sandbox-exec "${args[@]}" -- "$(mise which claude)" "$@"
}

main "$@"
