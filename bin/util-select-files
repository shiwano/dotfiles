#!/usr/bin/env bash

set -euo pipefail

usage() {
	local fd="${1:-2}"
	cat <<EOF >&"$fd"
Usage: util-select-files [-m|--modified] [dir]

Interactively select files.

Options:
  -m, --modified  Sort by modification time (newest first)

Examples:
  util-select-files
  util-select-files src
  util-select-files --modified .shiwano
EOF
}

main() {
	local sort_args=(--sort path)
	local dir="."

	while [[ $# -gt 0 ]]; do
		case $1 in
		-h | --help)
			usage 1
			return 0
			;;
		-m | --modified)
			sort_args=(--sortr modified)
			shift
			;;
		*)
			dir="$1"
			shift
			;;
		esac
	done

	local prompt="${FZF_PROMPT:-Select> }"

	local files
	files="$(rg --files --hidden --follow "${sort_args[@]}" -g '!**/.git' "$dir" 2>/dev/null | sed 's|^\./||' || true)"
	[ -z "$files" ] && return 0

	local selected
	selected="$(echo "$files" | fzf -m --prompt "$prompt")"
	[ -z "$selected" ] && return 0

	echo "$selected"
}

main "$@"
